# Copy to config.env (gitignored) and fill in. scripts/deploy.sh and the proof scripts
# read it. Nothing here is a secret — but OWNER_EMAIL is personal data, which is why
# the real file never enters the public repo (CI gets the same values as repository
# variables).

# The sandbox subscription. deploy.sh refuses to run if `az` points anywhere else.
SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# Owner tag on governed resource groups + budget/tripwire alert recipient.
OWNER_EMAIL=you@example.com

# Regions (validated defaults for a US free account; see docs/VALIDATION-LOG.md F8/F9).
LOCATION=eastus               # foundation, state, policy assignment identity
EVIDENCE_LOCATION=eastus2     # Cosmos DB + WORM storage
FUNCTIONS_LOCATION=centralus  # consumption Functions; probe: labs/00-setup/probe-quota.sh

# JSON list of automation object IDs whose control-plane writes are expected (the CI
# identity from scripts/arm-ci.sh). Empty until you arm CI.
TRUSTED_CALLERS='[]'
